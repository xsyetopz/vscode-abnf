{
  "Rule definition": {
    "prefix": "rule",
    "body": [
      "${1:rule-name} ::= ${2:expression}"
    ],
    "description": "Insert a BNF rule with ::=."
  },
  "Alternative": {
    "prefix": "alt",
    "body": [
      "${1:rule-name} ::= ${2:first}",
      "    | ${3:second}"
    ],
    "description": "Insert a BNF rule with two alternatives."
  },
  "Optional": {
    "prefix": "opt",
    "body": [
      "[${1:expression}]"
    ],
    "description": "Insert an optional BNF expression."
  },
  "Group": {
    "prefix": "group",
    "body": [
      "(${1:expression})"
    ],
    "description": "Insert a grouped BNF expression."
  },
  "RBNF angle rule": {
    "prefix": "angle",
    "body": [
      "<${1:rule name}> ::= ${2:expression}"
    ],
    "description": "Insert a rule name inside angle brackets."
  }
}
